@@ -127,0 +132,12 @@ func probe(client *Client, audio bool) ([]*core.Media, error) {
+func readyH265(model, quality string, codec *core.Codec) bool {
+	if model != "isa.camera.hlc7" || (quality != "" && quality != "hd" && quality != "2") {
+		return true
+	}
+	_, data, _ := h265.GetParameterSet(codec.FmtpLine)
+	if len(data) < 2 {
+		return false
+	}
+	sps := h265.DecodeSPS(data)
+	return sps != nil && sps.Width() > 640 && sps.Height() > 360
+}
